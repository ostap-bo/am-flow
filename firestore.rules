rules_version = '2';

// Правила безпеки Firestore для AM Flow.
// Дані доступні лише вам: після входу в застосунок і лише для вашого email.
// 1) Замініть YOUR_EMAIL@example.com на email, яким входите в AM Flow (малими літерами).
// 2) Firebase Console → Firestore Database → Rules → вставити цей текст → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == "YOUR_EMAIL@example.com";
    }
  }
}
